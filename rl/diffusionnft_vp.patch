+def _hf_stats(u8):
+    """Per-image high-frequency energy of grey uint8 NHWC images: Immerkaer noise sigma (no floor) and Laplacian variance."""
+    import cv2
+
+    M = np.array([[1, -2, 1], [-2, 4, -2], [1, -2, 1]], np.float32)
+    nz, lv = [], []
+    for x in u8:
+        g = cv2.cvtColor(x, cv2.COLOR_RGB2GRAY).astype(np.float32)
+        h, w = g.shape
+        c = cv2.filter2D(g, -1, M, borderType=cv2.BORDER_REFLECT)[1:-1, 1:-1]
+        nz.append(float(np.sqrt(np.pi / 2) * np.abs(c).sum() / (6 * (w - 2) * (h - 2))))
+        lv.append(float(cv2.Laplacian(g, cv2.CV_32F).var()))
+    return np.array(nz), np.array(lv)
+
+
+def vp_perspective(device):
+    """Perspective reward. $VP_REWARD selects the version: "v1" (default) = the frozen reward (vp_reward/FINAL.md,
+    vp_reward.final.perspective_reward); "v2" = the experimental vp_reward.reward_v2.perspective_reward (adds the upper
+    structure cap P_hi; NOT frozen). Lc_base map: $VP_LC_BASE (default dataset/vp_hypersim/lc_base.json), prompt -> mean Lc of 4 base SD3.5 rollouts.
+    Returns (R, info); info carries the reward parts + high-frequency image statistics (monitoring only, not in R)."""
+    import json, multiprocessing, os
+
+    repo = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+    from vp_reward.final import to_uint8_nhwc  # pip install -e <vp-perspective-rl>/vp_reward
+
+    version = os.environ.get("VP_REWARD", "v1")
+    if version == "v1":
+        from vp_reward.final import perspective_reward
+    elif version == "v2":
+        from vp_reward.reward_v2 import perspective_reward
+    else:
+        raise ValueError(f"VP_REWARD must be v1 or v2, got {version!r}")
+    print(f"[VP] reward version {version}", flush=True)
+
+    # geometry workers must not be forked from this multi-threaded CUDA process
+    if multiprocessing.get_start_method(allow_none=True) != "forkserver":
+        multiprocessing.set_start_method("forkserver", force=True)
+    lc_path = os.environ.get("VP_LC_BASE", os.path.join(repo, "dataset", "vp_hypersim", "lc_base.json"))
+    lc_base = json.load(open(lc_path))
+    fn = perspective_reward(device=device, lc_base=lc_base, n_workers=int(os.environ.get("VP_NWORKERS", "12")))
+
+    def _fn(images, prompts, metadata):
+        import time
+
+        t0 = time.time()
+        R, info = fn(images, prompts, metadata)
+        dt = time.time() - t0
+        nz, lv = _hf_stats(to_uint8_nhwc(images))
+        keep = ("G_raw", "G_nan", "zG", "Lc", "Lc_base", "P", "P_hi", "pickscore", "aesthetic", "zQ")
+        out = {k: np.asarray(info[k], dtype=np.float32) for k in keep if k in info}
+        out["hf_noise"], out["hf_lapvar"] = nz.astype(np.float32), lv.astype(np.float32)
+        out["t_reward"] = np.full(len(R), dt / max(len(R), 1), np.float32)  # reward wall time, spread over the batch
+        return R, out
+
+    return _fn
+
+
