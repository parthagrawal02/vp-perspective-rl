+def _vp_epoch_stats(gathered, zero_std_ratio):
+    """[VP] per-epoch summary of the frozen perspective reward parts (keys from flow_grpo.rewards.vp_perspective)."""
+    out = {"zero_std_ratio": float(zero_std_ratio)}
+    R = gathered["avg"][:, 0] if gathered["avg"].ndim == 2 else gathered["avg"]
+    out["R_mean"], out["R_std"] = float(np.mean(R)), float(np.std(R))
+    for k in ("zG", "G_raw", "P", "P_hi", "pickscore", "aesthetic", "zQ", "Lc", "Lc_base", "hf_noise", "hf_lapvar"):
+        v = gathered.get(f"vp_{k}")
+        if v is not None:
+            out[f"{k}_mean"], out[f"{k}_std"] = float(np.nanmean(v)), float(np.nanstd(v))
+    if "vp_G_nan" in gathered:
+        out["nan_rate"] = float(np.mean(gathered["vp_G_nan"]))
+    if "vp_P" in gathered:
+        out["floor_activity"] = float(np.mean(gathered["vp_P"] > 0))
+    if "vp_P_hi" in gathered:
+        out["cap_activity"] = float(np.mean(gathered["vp_P_hi"] > 0))
+    if "vp_t_reward" in gathered:
+        out["reward_compute_s_per_gpu"] = float(np.sum(gathered["vp_t_reward"]))
+    return out
+
+
+def _vp_append_csv(path, row):
+    import csv
+
+    new = not os.path.exists(path)
+    with open(path, "a", newline="") as f:
+        w = csv.DictWriter(f, fieldnames=list(row.keys()))
+        if new:
+            w.writeheader()
+        w.writerow(row)
+
